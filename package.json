{
  "name": "afternoon_tea",
  "private": true,
  "version": "1.0.10",
  "releaseNotes": "1. 修正複製文字格式(MM/DD HH:MM->MM/DD)",
  "author": "George",
  "description": "下午茶",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "app:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5174 && npm run electron:dev\"",
    "electron:build": "rimraf release && vite build && electron-builder && node scripts/generate-version.cjs",
    "version": "node scripts/generate-version.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hsu1110/afternoon-tea.git"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.7.3",
    "marked": "^17.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "element-plus": "^2.12.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.afternoon_tea.app",
    "productName": "下午茶",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hsu1110",
        "repo": "afternoon-tea"
      }
    ]
  }
}
