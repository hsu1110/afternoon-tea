{
  "name": "afternoon_tea",
  "version": "1.0.0",
  "description": "下午茶轉盤程式 - 隨機選擇下午茶店家",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "afternoon-tea",
    "wheel",
    "random"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.5",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.afternoon-tea.wheel",
    "productName": "下午茶轉盤",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.code-workspace",
      "!.vscode",
      "!node_modules"
    ]
  }
}
